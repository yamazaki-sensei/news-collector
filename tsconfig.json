{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Node がビルドなしで .ts を実行できるよう、型のみの構文に制約する。
    // 型注釈は実行時に剥がされるだけなので、消去に曖昧さが残る構文は禁止。
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
